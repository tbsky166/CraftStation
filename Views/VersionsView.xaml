<UserControl x:Class="CraftStation.Views.VersionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="版本库" Style="{StaticResource PageTitleStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="搜索版本"/>
                        <Button Grid.Column="1" Content="刷新" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding RefreshCommand}" Margin="8,0,0,0"/>
                    </Grid>
                </StackPanel>
                <ListBox Grid.Row="1" Margin="0,12,0,0"
                         ItemsSource="{Binding Versions}"
                         SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextFaintBrush}"
                                               FontSize="11" Margin="10,2,0,0"/>
                                    <Border Style="{StaticResource SuccessBadgeStyle}" Margin="10,0,0,0"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="已安装" Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding ReleaseTimeUtc, StringFormat=yyyy-MM-dd}"
                                           Foreground="{StaticResource TextFaintBrush}" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="版本详情" Style="{StaticResource PageTitleStyle}"/>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedVersion.Name, FallbackValue=未选择版本}" FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedVersion.TypeLabel, FallbackValue=-}"
                                   Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="安装" Style="{StaticResource PrimaryButtonStyle}"
                                    Command="{Binding InstallCommand}"/>
                            <Button Content="修复" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding RepairCommand}" Margin="8,0,0,0"/>
                            <Button Content="删除" Style="{StaticResource DangerButtonStyle}"
                                    Command="{Binding DeleteCommand}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="加载器安装" Style="{StaticResource SectionTitleStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding LoaderKinds}"
                                      SelectedItem="{Binding SelectedLoader, Mode=TwoWay}"/>
                            <ComboBox Grid.Column="1" Margin="8,0,0,0"
                                      ItemsSource="{Binding LoaderVersions}"
                                      SelectedItem="{Binding SelectedLoaderVersion, Mode=TwoWay}"/>
                            <Button Grid.Column="2" Content="获取版本" Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding LoadLoaderVersionsCommand}" Margin="8,0,0,0"/>
                        </Grid>
                        <Button Content="安装加载器" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding InstallLoaderCommand}" Margin="0,14,0,0"
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="状态" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,10,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
