<UserControl x:Class="CraftStation.Views.AccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
            <StackPanel>
                <TextBlock Text="账户" Style="{StaticResource PageTitleStyle}"/>
                <TextBlock Text="离线账户" Style="{StaticResource SectionTitleStyle}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding OfflineName, UpdateSourceTrigger=PropertyChanged}" ToolTip="离线用户名"/>
                    <Button Grid.Column="1" Content="添加" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding AddOfflineCommand}" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="微软正版登录" Style="{StaticResource SectionTitleStyle}"/>
                <Button Content="使用内置浏览器登录" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding LoginMicrosoftCommand}"/>
                <Button Content="使用设备码登录（回退）" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding LoginDeviceCodeCommand}" Margin="0,8,0,0"/>
                <TextBlock Text="{Binding DeviceCode}" Foreground="{StaticResource AccentBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}"
                           TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <TextBlock Text="账户列表" Style="{StaticResource PageTitleStyle}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <ListBox ItemsSource="{Binding AccountList}"
                             SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource TextFaintBrush}"
                                               FontSize="11" Margin="10,2,0,0"/>
                                    <Button Content="设为当前" Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Padding="8,2" Margin="16,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="下载皮肤" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding DownloadSkinCommand}"/>
                        <Button Content="移除选中账户" Style="{StaticResource DangerButtonStyle}"
                                Command="{Binding RemoveCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
