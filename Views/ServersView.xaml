<UserControl x:Class="CraftStation.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0">
            <StackPanel>
                <TextBlock Text="服务器" Style="{StaticResource PageTitleStyle}"/>
                <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" ToolTip="名称"/>
                <TextBox Text="{Binding NewAddress, UpdateSourceTrigger=PropertyChanged}" ToolTip="地址，如 play.example.com" Margin="0,8,0,0"/>
                <TextBox Text="{Binding NewPort, UpdateSourceTrigger=PropertyChanged}" ToolTip="端口" Margin="0,8,0,0"/>
                <Button Content="添加服务器" Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding AddCommand}" Margin="0,10,0,0"/>
                <ListBox ItemsSource="{Binding ServerList}"
                         SelectedItem="{Binding SelectedServer, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         Margin="0,12,0,0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="{StaticResource TextFaintBrush}">
                                    <Run Text="{Binding Address}"/><Run Text=":"/><Run Text="{Binding Port}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Content="删除选中服务器" Style="{StaticResource DangerButtonStyle}"
                        Command="{Binding DeleteCommand}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="2">
            <TextBlock Text="服务器详情" Style="{StaticResource PageTitleStyle}"/>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedServer.Name, FallbackValue=未选择服务器}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedServer.Address, FallbackValue=-}"
                               Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="Ping" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding PingCommand}"/>
                        <Button Content="直连启动" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding LaunchCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="在线状态" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="{Binding Status.Motd}" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Status.Version, StringFormat=版本：{0}}" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding Status.PlayersOnline, StringFormat=在线：{0}}" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding Status.PlayersMax, StringFormat=最大：{0}}" Foreground="{StaticResource TextDimBrush}"/>
                    <TextBlock Text="{Binding Status.LatencyMs, StringFormat=延迟：{0} ms}" Foreground="{StaticResource TextDimBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
