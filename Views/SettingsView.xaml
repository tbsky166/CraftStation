<UserControl x:Class="CraftStation.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}"/>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="游戏目录" Style="{StaticResource DimTextStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="浏览" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding BrowseGameDirectoryCommand}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="下载源" Style="{StaticResource DimTextStyle}" Margin="0,10,0,4"/>
                    <ComboBox ItemsSource="{Binding DownloadSources}"
                              SelectedItem="{Binding DownloadSource, Mode=TwoWay}"/>
                    <CheckBox Content="镜像失败时自动回退官方源" IsChecked="{Binding FallbackEnabled}"
                              Foreground="{StaticResource TextDimBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="微软正版登录已内置，无需配置"
                               Style="{StaticResource DimTextStyle}" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="代理（如 http://127.0.0.1:7890）" Style="{StaticResource DimTextStyle}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="下载并发数" Style="{StaticResource DimTextStyle}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding MaxConcurrency, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="更新与外部服务" Style="{StaticResource SectionTitleStyle}"/>
                    <TextBlock Text="GitHub 更新源（仓库地址）" Style="{StaticResource DimTextStyle}"/>
                    <TextBox Text="{Binding UpdateEndpoint, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="CurseForge API Key（可选）" Style="{StaticResource DimTextStyle}" Margin="0,10,0,4"/>
                    <TextBox Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="检查更新" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding CheckUpdateCommand}"/>
                        <Button Content="打开数据目录" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenDataFolderCommand}" Margin="8,0,0,0"/>
                        <Button Content="打开 Web 界面（内嵌 HTML）" Style="{StaticResource OutlineButtonStyle}"
                                Command="{Binding OpenHtmlPreviewCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button Content="保存设置" Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding SaveCommand}" HorizontalAlignment="Left" MinWidth="140"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
