<UserControl x:Class="CraftStation.Views.ResourcesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="资源管理" Style="{StaticResource PageTitleStyle}"/>
        <TabControl Grid.Row="1">
            <TabItem Header="模组">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入模组" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportModCommand}"/>
                        <Button Content="打开 mods 目录" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderCommand}" CommandParameter="mods" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="0,12,0,0"
                             ItemsSource="{Binding Mods}"
                             SelectedItem="{Binding SelectedResource, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextFaintBrush}" Margin="10,2,0,0"/>
                                    <TextBlock Text="已禁用" Foreground="{StaticResource DangerBrush}"
                                               Margin="10,2,0,0"
                                               Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}"/>
                                    <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                        <Button Content="启用/禁用" Style="{StaticResource SecondaryButtonStyle}"
                                                Command="{Binding DataContext.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="8,2"/>
                                        <Button Content="删除" Style="{StaticResource DangerButtonStyle}"
                                                Command="{Binding DataContext.DeleteResourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Padding="8,2" Margin="6,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="资源包">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入资源包" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportResourcePackCommand}"/>
                        <Button Content="打开目录" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderCommand}" CommandParameter="resourcepacks" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="0,12,0,0"
                             ItemsSource="{Binding ResourcePacks}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontSize="14"/>
                                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource TextFaintBrush}" Margin="10,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="光影包">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="导入光影包" Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ImportShaderPackCommand}"/>
                        <Button Content="打开目录" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding OpenFolderCommand}" CommandParameter="shaderpacks" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox Grid.Row="1" Margin="0,12,0,0"
                             ItemsSource="{Binding ShaderPacks}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontSize="14"/>
                                    <TextBlock Text="{Binding SizeLabel}" Foreground="{StaticResource TextFaintBrush}" Margin="10,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="存档">
                <ListBox ItemsSource="{Binding Saves}"
                         ItemContainerStyle="{StaticResource NavItemStyle}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding GameMode}" Foreground="{StaticResource TextFaintBrush}" Margin="10,2,0,0"/>
                                <TextBlock Text="{Binding Difficulty}" Foreground="{StaticResource TextFaintBrush}" Margin="8,2,0,0"/>
                                <TextBlock Text="{Binding LastPlayedUtc, StringFormat=最后游玩：{0:yyyy-MM-dd HH:mm}}" 
                                           Foreground="{StaticResource TextFaintBrush}" Margin="12,2,0,0"/>
                                <Button Content="打开目录" Style="{StaticResource SecondaryButtonStyle}"
                                        Command="{Binding DataContext.OpenSaveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Padding="8,2" Margin="16,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
