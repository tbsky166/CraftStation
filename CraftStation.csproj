<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="CraftStation.Core\CraftStation.Core.csproj" />
  </ItemGroup>

  <!-- 子模块目录不参与本项目的默认编译/资源扫描 -->
  <ItemGroup>
    <Compile Remove="CraftStation.Core/**;CraftStation.Tests/**" />
    <None Remove="CraftStation.Core/**;CraftStation.Tests/**" />
    <Content Remove="CraftStation.Core/**;CraftStation.Tests/**" />
    <Resource Remove="CraftStation.Core/**;CraftStation.Tests/**" />
    <Page Remove="CraftStation.Core/**;CraftStation.Tests/**" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Fonts\Rajdhani-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Rajdhani-Medium.ttf" />
    <!-- Web 界面资源编译进程序集，发布后不残留 Assets 文件夹 -->
    <EmbeddedResource Include="Assets\Web\**\*" />
  </ItemGroup>

  <!-- WebView2 固定版运行时：存在时嵌入 exe，首次运行自动解压到 LocalAppData（该文件夹不入库） -->
  <ItemGroup Condition="Exists('WebView2Runtime\msedgewebview2.exe')">
    <EmbeddedResource Include="WebView2Runtime\**\*" LogicalName="wruntime/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageReference Include="Microsoft.Identity.Client.Desktop" Version="4.61.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.1823.32" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
