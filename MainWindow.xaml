<Window x:Class="CraftStation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CraftStation"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Loaded="Window_OnLoaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3"/>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="4"/>
        </Grid.RowDefinitions>

        <!-- fz.wiki top-signal-strip：3px 金色信号条 -->
        <Rectangle Grid.Row="0" Fill="{StaticResource FzSignalStripBrush}"/>

        <!-- 顶部状态栏：深色，无白色 -->
        <Border Grid.Row="1" Background="#0D0D0D"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="26" Height="4" Fill="{StaticResource CmykStripBrush}" Margin="0,0,12,0"/>
                    <TextBlock Text="CRAFTSTATION" FontFamily="{StaticResource DisplayFont}"
                               FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text=" / " Foreground="{StaticResource TextFaintBrush}" Margin="8,0"/>
                    <TextBlock Text="{Binding PageTitle}" Foreground="{StaticResource TextDimBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding InstanceLabel}" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12"/>
                    </Border>
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="2" Padding="10,4">
                        <TextBlock Text="{Binding AccountLabel}" Foreground="{StaticResource TextDimBrush}"
                                   FontSize="12"/>
                    </Border>
                </StackPanel>
                <Button Grid.Column="3" Content="&#xE921;" Click="Minimize_Click"
                        Style="{StaticResource WindowButtonStyle}"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                <Button Grid.Column="4" Content="&#xE922;" Click="Maximize_Click"
                        Style="{StaticResource WindowButtonStyle}"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                <Button Grid.Column="5" Content="&#xE8BB;" Click="Close_Click"
                        Style="{StaticResource WindowCloseButtonStyle}"
                        FontFamily="Segoe MDL2 Assets" FontSize="12"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="84"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧导航：深色 + 细网格底纹 -->
            <Border Grid.Column="0" Background="#0D0D0D"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Rectangle Fill="{StaticResource GridBrush}" Opacity="0.7" IsHitTestVisible="False"/>
                    <ListBox x:Name="NavList"
                             ItemsSource="{Binding NavItems}"
                             SelectedValuePath="Key"
                             SelectedIndex="0"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             SelectionChanged="NavList_OnSelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               FontSize="16" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="11"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border VerticalAlignment="Bottom" Height="4" Margin="8,0"
                            Background="{StaticResource CmykStripBrush}" Opacity="0.55"/>
                </Grid>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Column="1"
                            Content="{Binding CurrentPage}"
                            Margin="24"
                            RenderTransformOrigin="0.5,0">
                <ContentControl.RenderTransform>
                    <TranslateTransform Y="0"/>
                </ContentControl.RenderTransform>
            </ContentControl>
        </Grid>

        <Rectangle Grid.Row="3" Fill="{StaticResource CmykStripBrush}"/>
    </Grid>
</Window>
