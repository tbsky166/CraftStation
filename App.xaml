<Application x:Class="CraftStation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CraftStation.ViewModels"
             xmlns:conv="clr-namespace:CraftStation.Converters"
             xmlns:views="clr-namespace:CraftStation.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Endfield.xaml"/>
                <ResourceDictionary Source="Themes/FzWikiControls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:SeverityToBrushConverter x:Key="SeverityToBrushConverter"/>

            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:VersionsViewModel}">
                <views:VersionsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:InstancesViewModel}">
                <views:InstancesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResourcesViewModel}">
                <views:ResourcesView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ModHealthViewModel}">
                <views:ModHealthView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServersViewModel}">
                <views:ServersView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountsViewModel}">
                <views:AccountsView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StoreViewModel}">
                <views:StoreView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
